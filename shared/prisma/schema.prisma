generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("users")
}

model Service {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  priceCents  Int
  slotMin     Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appointments Appointment[]

  @@map("services")
}

model Appointment {
  id                 String   @id @default(cuid())
  customerId         String?
  serviceId          String
  customerName       String
  customerPhone      String
  startsAt           DateTime
  endsAt             DateTime
  priceCents         Int
  status             AppointmentStatus @default(AGUARDANDO_CONFIRMACAO)
  previousStartsAt   DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  reminders AppointmentReminder[]

  @@index([startsAt, status])
  @@index([startsAt, endsAt, status])
  @@index([customerId, startsAt])
  @@map("appointments")
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]

  @@index([name])
  @@map("customers")
}

model AppointmentReminder {
  id                    String                    @id @default(cuid())
  appointmentId         String
  scheduledAt           DateTime
  nextAttemptAt         DateTime
  status                AppointmentReminderStatus @default(PENDING)
  attemptCount          Int                       @default(0)
  lastAttemptAt         DateTime?
  sentAt                DateTime?
  providerResponseCode  Int?
  lastError             String?                   @db.Text
  idempotencyKey        String                    @unique
  leaseExpiresAt        DateTime?
  leaseToken            String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([appointmentId, createdAt])
  @@map("appointment_reminders")
}

model BusinessHours {
  id         String   @id @default(cuid())
  weekday    Int      // 0=Domingo ... 6=Sábado
  opensAt    String   // "09:00"
  closesAt   String   // "18:00"
  breakStart String?  // "12:00"
  breakEnd   String?  // "13:00"
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([weekday])
  @@map("business_hours")
}

model Block {
  id        String   @id @default(cuid())
  startsAt  DateTime
  endsAt    DateTime
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startsAt, endsAt])
  @@map("blocks")
}

model Settings {
  id              String   @id @default(cuid())
  minNoticeHours  Int      @default(2)
  maxDaysAhead    Int      @default(60)
  companyName     String   @default("Seu Carlos Barbearia")
  heroText        String?
  heroImageUrl    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("settings")
}

enum AppointmentStatus {
  AGUARDANDO_CONFIRMACAO
  CONFIRMADO
  CANCELADO
  REAGENDADO
}

enum AppointmentReminderStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

model WhatsAppIntegration {
  id                String @id @default("default")
  provider          WhatsAppProvider?
  wameApiKey        String?
  zapsterApiToken    String?
  zapsterInstanceId  String?
  messageAwaitingConfirmation String? @db.Text
  messageConfirmed             String? @db.Text
  messageCancelled              String? @db.Text
  messageRescheduled            String? @db.Text
  reminderEnabled               Boolean @default(false)
  reminderHoursBefore           Int     @default(24)
  messageReminder               String? @db.Text
  updatedAt         DateTime @updatedAt

  @@map("whatsapp_integration")
}

enum WhatsAppProvider {
  WAME
  ZAPSTER
}
