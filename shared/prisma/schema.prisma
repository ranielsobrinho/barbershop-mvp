generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships TenantMembership[]

  @@map("users")
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships         TenantMembership[]
  barbers             Barber[]
  services            Service[]
  appointments        Appointment[]
  customers           Customer[]
  reminders           AppointmentReminder[]
  businessHours       BusinessHours[]
  blocks              Block[]
  settings            Settings[]
  whatsappIntegration WhatsAppIntegration[]

  @@map("tenants")
}

model TenantMembership {
  id        String     @id @default(cuid())
  tenantId  String
  userId    String
  role      TenantRole @default(STAFF)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("tenant_memberships")
}

model Barber {
  id        String   @id @default(cuid())
  tenantId  String   @default("tenant_seu_carlos")
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  appointments Appointment[]
  businessHours BarberBusinessHours[]
  blocks Block[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@map("barbers")
}

model BarberBusinessHours {
  id         String   @id @default(cuid())
  tenantId   String   @default("tenant_seu_carlos")
  barberId   String
  weekday    Int
  opensAt    String
  closesAt   String
  breakStart String?
  breakEnd   String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  barber Barber @relation(fields: [tenantId, barberId], references: [tenantId, id], onDelete: Restrict)

  @@unique([barberId, weekday])
  @@index([tenantId, weekday])
  @@map("barber_business_hours")
}

model Service {
  id          String   @id @default(cuid())
  tenantId    String   @default("tenant_seu_carlos")
  name        String
  description String?
  priceCents  Int
  slotMin     Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appointments Appointment[]
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("services")
}

model Appointment {
  id                 String   @id @default(cuid())
  tenantId           String   @default("tenant_seu_carlos")
  barberId           String   @default("barber_seu_carlos")
  customerId         String?
  serviceId          String
  customerName       String
  customerPhone      String
  startsAt           DateTime
  endsAt             DateTime
  priceCents         Int
  status             AppointmentStatus @default(AGUARDANDO_CONFIRMACAO)
  previousStartsAt   DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  service Service @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict)
  customer Customer? @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  reminders AppointmentReminder[]
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  barber Barber @relation(fields: [tenantId, barberId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, startsAt, status])
  @@index([startsAt, status])
  @@index([startsAt, endsAt, status])
  @@index([customerId, startsAt])
  @@map("appointments")
}

model Customer {
  id        String   @id @default(cuid())
  tenantId  String   @default("tenant_seu_carlos")
  name      String
  phone     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([name])
  @@map("customers")
}

model AppointmentReminder {
  id                    String                    @id @default(cuid())
  tenantId              String                    @default("tenant_seu_carlos")
  appointmentId         String
  scheduledAt           DateTime
  nextAttemptAt         DateTime
  status                AppointmentReminderStatus @default(PENDING)
  attemptCount          Int                       @default(0)
  lastAttemptAt         DateTime?
  sentAt                DateTime?
  providerResponseCode  Int?
  lastError             String?                   @db.Text
  idempotencyKey        String
  leaseExpiresAt        DateTime?
  leaseToken            String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  appointment Appointment @relation(fields: [tenantId, appointmentId], references: [tenantId, id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, status, nextAttemptAt])
  @@unique([tenantId, idempotencyKey])
  @@index([status, nextAttemptAt])
  @@index([appointmentId, createdAt])
  @@map("appointment_reminders")
}

model BusinessHours {
  id         String   @id @default(cuid())
  tenantId   String   @default("tenant_seu_carlos")
  weekday    Int      // 0=Domingo ... 6=Sábado
  opensAt    String   // "09:00"
  closesAt   String   // "18:00"
  breakStart String?  // "12:00"
  breakEnd   String?  // "13:00"
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@unique([tenantId, weekday])
  @@map("business_hours")
}

model Block {
  id        String   @id @default(cuid())
  tenantId  String   @default("tenant_seu_carlos")
  barberId  String?
  startsAt  DateTime
  endsAt    DateTime
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  barber Barber? @relation(fields: [tenantId, barberId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, startsAt, endsAt])
  @@index([tenantId, barberId, startsAt, endsAt])
  @@index([startsAt, endsAt])
  @@map("blocks")
}

model Settings {
  id              String   @default("default")
  tenantId        String   @default("tenant_seu_carlos")
  minNoticeHours  Int      @default(2)
  maxDaysAhead    Int      @default(60)
  companyName     String   @default("Seu Carlos Barbearia")
  heroText        String?
  heroImageUrl    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([tenantId, id])
  @@index([tenantId])
  @@map("settings")
}

enum AppointmentStatus {
  AGUARDANDO_CONFIRMACAO
  CONFIRMADO
  CANCELADO
  REAGENDADO
}

enum AppointmentReminderStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum TenantRole {
  OWNER
  ADMIN
  STAFF
}

model WhatsAppIntegration {
  id                String @default("default")
  tenantId          String @default("tenant_seu_carlos")
  provider          WhatsAppProvider?
  wameApiKey        String?
  zapsterApiToken    String?
  zapsterInstanceId  String?
  messageAwaitingConfirmation String? @db.Text
  messageConfirmed             String? @db.Text
  messageCancelled              String? @db.Text
  messageRescheduled            String? @db.Text
  reminderEnabled               Boolean @default(false)
  reminderHoursBefore           Int     @default(24)
  messageReminder               String? @db.Text
  updatedAt         DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([tenantId, id])
  @@index([tenantId])
  @@map("whatsapp_integration")
}

enum WhatsAppProvider {
  WAME
  ZAPSTER
}
