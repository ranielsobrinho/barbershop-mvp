{
  "name": "@barbershop/auth-service",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
    "build": "pnpm proto:generate && tsc",
    "start": "node --env-file=.env dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "proto:generate": "mkdir -p src/interfaces/grpc/generated && grpc_tools_node_protoc --proto_path=../../shared/proto --plugin=protoc-gen-ts_proto=$PWD/node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=src/interfaces/grpc/generated --ts_proto_opt=outputServices=grpc-js,esModuleInterop=true,env=node,importSuffix=.js auth.proto"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.0.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@grpc/grpc-js": "^1.11.0",
    "@prisma/client": "^5.15.0",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.12.5",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.0.0",
    "grpc-tools": "^1.13.1",
    "pino-pretty": "^13.2.0",
    "ts-proto": "^2.6.0",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
