# Database
DATABASE_URL=postgresql://barbershop:barbershop@localhost:5432/barbershop

# JWT
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# Cookie
COOKIE_SECRET=cookie-secret-change-in-production

# Service Ports
API_GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
AUTH_SERVICE_GRPC_PORT=5001
SCHEDULING_SERVICE_PORT=3002
SCHEDULING_SERVICE_GRPC_PORT=5002
SERVICES_SERVICE_PORT=3003
SERVICES_SERVICE_GRPC_PORT=5003
BLOCKS_SERVICE_PORT=3004
BLOCKS_SERVICE_GRPC_PORT=5004
BUSINESS_HOURS_SERVICE_PORT=3005
BUSINESS_HOURS_SERVICE_GRPC_PORT=5005
SETTINGS_SERVICE_PORT=3006
SETTINGS_SERVICE_GRPC_PORT=5006

# Frontend
VITE_API_URL=http://localhost:3000

# Node Environment
NODE_ENV=development
